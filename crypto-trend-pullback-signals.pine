//@version=5
// ─────────────────────────────────────────────────────────────────────────────
// 추세 눌림목 진입 타점 [EMA 정렬 + 되돌림 + 모멘텀 재개]
//
// 배경    : 역추세(반전) 전략이 2024~2026 실전 검증에서 엣지를 잃어 (backtest/
//           RESULTS.md 5차), 시장 성격(추세 지배)에 정렬된 추세 순응 계열로 전환.
// 검증    : 8개 데이터셋 (BTC 1h/4h/일봉, ETH/LTC 일봉, EURUSD, GOOGL) —
//           풀링 567 트레이드 PF 1.13 (수수료 스트레스 0.08%에서 1.08),
//           BTC 1h 270 트레이드 PF 1.35 · 누적 +261% (2017~2019, 표본 대형).
//           크립토 "일봉"은 검증 실패 → 1h~4h 인트라데이 전용.
//
// 진입 로직 (전 조건 동시 충족, 봉 마감 확정):
//   롱  ① 추세: EMA20 > EMA50 > EMA200 정렬 + 종가 > EMA200
//       ② 눌림: 최근 N봉 내 저가가 EMA20 터치/이탈
//       ③ 깊이: 눌림 중 RSI가 50 아래로 내려갔다 옴
//       ④ 재개: 종가가 EMA20 위 복귀 + 전봉 고가 돌파 (모멘텀 확인)
//   숏  완전 대칭
//
// 리스크 : 손절 = max(스윙 저점-0.5ATR, 원금 한도 환산가) — 손실이 한도 초과 불가
//           TP1 = +1R (30% 부분 익절 + 본절 이동), TP2 = +4R (추세 수익 극대화)
// 용도    : 수동 실행 보조. 신호 발생 시 라벨의 진입가/손절가/익절가를 확인하고
//           본인이 최종 판단하여 거래소에서 주문. 알림 설정 지원.
// ─────────────────────────────────────────────────────────────────────────────
indicator("추세 눌림목 타점 [EMA+RSI+모멘텀]", shorttitle="눌림목 타점", overlay=true, max_labels_count=500, max_lines_count=500)

// ═══════════════ 1. 입력값 ═══════════════
grpTrend = "① 추세 판정"
emaFastLen = input.int(20,  "단기 EMA (눌림 기준선)", minval=1, group=grpTrend)
emaMidLen  = input.int(50,  "중기 EMA", minval=1, group=grpTrend)
emaSlowLen = input.int(200, "장기 EMA", minval=1, group=grpTrend)

grpPull = "② 눌림목 조건"
pullLookback = input.int(5, "눌림 인정 봉 수 (최근 N봉 내 EMA20 터치)", minval=1, group=grpPull)
rsiLen = input.int(14, "RSI 기간", minval=1, group=grpPull)
rsiMid = input.float(50, "RSI 되돌림 기준 (롱: 이 값 아래로 눌림)", minval=30, maxval=70, group=grpPull)

grpRisk = "③ 리스크 관리 (필수 확인!)"
capital    = input.float(1000, "운용 원금 (USDT)", minval=1, group=grpRisk)
leverage   = input.float(2,  "레버리지 (배)", minval=1, step=0.5, group=grpRisk)
maxLossPct = input.float(4,  "원금 대비 최대 손실 한도 (%)", minval=0.5, step=0.5, group=grpRisk, tooltip="검증 설정: 한도 4% ÷ 레버리지 2배 = 가격 손절폭 2%. 리스크를 줄이려면 한도와 레버리지를 같은 비율로 낮출 것 (예: 3%/1.5배) — 한도만 낮추면 손절폭이 좁아져 검증과 다른 전략이 됨")
swingLen   = input.int(10, "스윙 저/고점 탐색 봉 수", minval=2, group=grpRisk)

grpTP = "④ 분할 익절"
tp1R = input.float(1.0, "1차 목표 (R)", minval=0.1, step=0.1, group=grpTP, tooltip="도달 시 30% 부분 익절 + 손절을 본절로 이동 권장")
tp2R = input.float(4.0, "2차 목표 (R)", minval=0.5, step=0.1, group=grpTP, tooltip="추세 전략은 꼬리가 길어야 함 — 검증상 4R이 2R보다 우수")

grpSig = "⑤ 신호 설정"
cooldown  = input.int(10, "신호 재발생 최소 간격 (봉)", minval=0, group=grpSig)
showTable = input.bool(true, "상태 요약 테이블 표시", group=grpSig)

// ═══════════════ 2. 지표 계산 ═══════════════
ema20  = ta.ema(close, emaFastLen)
ema50  = ta.ema(close, emaMidLen)
ema200 = ta.ema(close, emaSlowLen)
rsi = ta.rsi(close, rsiLen)
atr = ta.atr(14)

// ═══════════════ 3. 진입 조건 ═══════════════
upTrend = ema20 > ema50 and ema50 > ema200 and close > ema200
dnTrend = ema20 < ema50 and ema50 < ema200 and close < ema200

pullL = ta.barssince(low  <= ema20) <= pullLookback   // 상승 추세 속 눌림
pullS = ta.barssince(high >= ema20) <= pullLookback   // 하락 추세 속 반등
dipL  = ta.barssince(rsi < rsiMid) <= pullLookback    // 되돌림 깊이 확인
popS  = ta.barssince(rsi > 100 - rsiMid) <= pullLookback

crossUp = close > ema20 and not (close[1] > ema20[1])   // EMA20 위 복귀
crossDn = close < ema20 and not (close[1] < ema20[1])
momUp = close > high[1]                                  // 전봉 고가 돌파
momDn = close < low[1]

var int lastSignalBar = -99999
canSignal = bar_index - lastSignalBar > cooldown

longSignal  = upTrend and pullL and dipL and crossUp and momUp and canSignal and barstate.isconfirmed
shortSignal = dnTrend and pullS and popS and crossDn and momDn and not longSignal and canSignal and barstate.isconfirmed

if longSignal or shortSignal
    lastSignalBar := bar_index

// ═══════════════ 4. 손절/익절 계산 ═══════════════
priceStopPct = maxLossPct / leverage / 100.0

f_levels(bool isLong) =>
    entry = close
    slCap = isLong ? entry * (1 - priceStopPct) : entry * (1 + priceStopPct)
    slSwing = isLong ? ta.lowest(low, swingLen) - 0.5 * atr : ta.highest(high, swingLen) + 0.5 * atr
    sl = isLong ? math.max(slCap, slSwing) : math.min(slCap, slSwing)
    if (isLong and sl >= entry) or (not isLong and sl <= entry)
        sl := slCap
    r = math.abs(entry - sl)
    tp1 = isLong ? entry + r * tp1R : entry - r * tp1R
    tp2 = isLong ? entry + r * tp2R : entry - r * tp2R
    [entry, sl, tp1, tp2]

f_reasons(bool isLong) =>
    string s = ""
    if isLong
        s += "· EMA 20>50>200 상승 정렬 (추세 확인)\n"
        s += "· EMA20 눌림 발생 후 복귀\n"
        s += "· RSI 되돌림(" + str.tostring(rsi, "#.#") + ") 소화 완료\n"
        s += "· 전봉 고가 돌파 — 상승 모멘텀 재개\n"
    else
        s += "· EMA 20<50<200 하락 정렬 (추세 확인)\n"
        s += "· EMA20 반등 발생 후 이탈\n"
        s += "· RSI 반등(" + str.tostring(rsi, "#.#") + ") 소화 완료\n"
        s += "· 전봉 저가 이탈 — 하락 모멘텀 재개\n"
    s

f_drawSignal(bool isLong) =>
    [entry, sl, tp1, tp2] = f_levels(isLong)
    lossPct = math.abs(entry - sl) / entry * leverage * 100
    posSize = capital * leverage
    qty = posSize / entry
    dir = isLong ? "롱(LONG) 눌림목 진입 후보" : "숏(SHORT) 되돌림 진입 후보"
    txt = "◆ " + dir + " ◆\n"
      + "진입가: " + str.tostring(entry, format.mintick) + "\n"
      + "손절가: " + str.tostring(sl, format.mintick) + "  (원금 " + str.tostring(-lossPct, "#.##") + "%)\n"
      + "1차 익절: " + str.tostring(tp1, format.mintick) + "  (" + str.tostring(tp1R, "#.#") + "R, 30% 청산+본절 이동)\n"
      + "2차 익절: " + str.tostring(tp2, format.mintick) + "  (" + str.tostring(tp2R, "#.#") + "R, 잔량 청산)\n"
      + "권장 수량: " + str.tostring(qty, "#.####") + " (" + str.tostring(leverage, "#.#") + "x, " + str.tostring(posSize, "#") + " USDT)\n"
      + "─── 근거 ───\n" + f_reasons(isLong)
    label.new(bar_index, isLong ? low : high, txt,
      style=isLong ? label.style_label_up : label.style_label_down,
      color=isLong ? color.new(color.teal, 10) : color.new(color.maroon, 10),
      textcolor=color.white, size=size.small, textalign=text.align_left)
    ext = 20
    line.new(bar_index, entry, bar_index + ext, entry, color=color.gray,  width=1)
    line.new(bar_index, sl,    bar_index + ext, sl,    color=color.red,   width=2, style=line.style_dashed)
    line.new(bar_index, tp1,   bar_index + ext, tp1,   color=color.green, width=1, style=line.style_dotted)
    line.new(bar_index, tp2,   bar_index + ext, tp2,   color=color.lime,  width=2, style=line.style_dotted)
    label.new(bar_index + ext, sl,  "SL "  + str.tostring(sl,  format.mintick), style=label.style_label_left, color=color.new(color.red,   70), textcolor=color.white, size=size.tiny)
    label.new(bar_index + ext, tp1, "TP1 " + str.tostring(tp1, format.mintick), style=label.style_label_left, color=color.new(color.green, 70), textcolor=color.white, size=size.tiny)
    label.new(bar_index + ext, tp2, "TP2 " + str.tostring(tp2, format.mintick), style=label.style_label_left, color=color.new(color.lime,  70), textcolor=color.white, size=size.tiny)

if longSignal
    f_drawSignal(true)
if shortSignal
    f_drawSignal(false)

// ═══════════════ 5. 차트 표시 ═══════════════
plot(ema20,  "EMA 20",  color=color.new(color.yellow, 0), linewidth=1)
plot(ema50,  "EMA 50",  color=color.new(color.orange, 0), linewidth=1)
plot(ema200, "EMA 200", color=color.new(color.purple, 0), linewidth=2)
plotshape(longSignal,  "롱 신호", shape.triangleup,   location.belowbar, color.new(color.teal, 0),   size=size.small)
plotshape(shortSignal, "숏 신호", shape.triangledown, location.abovebar, color.new(color.maroon, 0), size=size.small)

// ═══════════════ 6. 상태 요약 테이블 ═══════════════
var table t = table.new(position.top_right, 2, 5, bgcolor=color.new(color.black, 20), border_width=1, border_color=color.new(color.gray, 60))
if showTable and barstate.islast
    trendTxt = upTrend ? "상승 정렬 (롱 대기)" : dnTrend ? "하락 정렬 (숏 대기)" : "정렬 안 됨 (관망)"
    trendCol = upTrend ? color.green : dnTrend ? color.red : color.gray
    pullTxt = upTrend ? (pullL ? "눌림 발생 — 복귀 감시" : "눌림 대기") : dnTrend ? (pullS ? "반등 발생 — 이탈 감시" : "반등 대기") : "-"
    rsiTxt = str.tostring(rsi, "#.#")
    slPctTxt = "-" + str.tostring(priceStopPct * 100, "#.##") + "% (원금 -" + str.tostring(maxLossPct, "#.#") + "%)"
    table.cell(t, 0, 0, "추세 정렬",   text_color=color.white, text_size=size.tiny), table.cell(t, 1, 0, trendTxt, text_color=trendCol, text_size=size.tiny)
    table.cell(t, 0, 1, "눌림 상태",   text_color=color.white, text_size=size.tiny), table.cell(t, 1, 1, pullTxt,  text_color=color.silver, text_size=size.tiny)
    table.cell(t, 0, 2, "RSI",        text_color=color.white, text_size=size.tiny), table.cell(t, 1, 2, rsiTxt,   text_color=color.silver, text_size=size.tiny)
    table.cell(t, 0, 3, "한도 손절폭", text_color=color.white, text_size=size.tiny), table.cell(t, 1, 3, slPctTxt, text_color=color.orange, text_size=size.tiny)
    table.cell(t, 0, 4, "권장 TF",    text_color=color.white, text_size=size.tiny), table.cell(t, 1, 4, "1h~4h (일봉 비추천)", text_color=color.silver, text_size=size.tiny)

// ═══════════════ 7. 알림 ═══════════════
alertcondition(longSignal,  "롱 눌림목 신호", "눌림목 타점: 롱 진입 후보 — 차트에서 진입가/손절가/익절가 확인")
alertcondition(shortSignal, "숏 되돌림 신호", "눌림목 타점: 숏 진입 후보 — 차트에서 진입가/손절가/익절가 확인")
