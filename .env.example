# 감시할 Binance USDT 무기한 선물 심볼 (쉼표 구분)
SYMBOLS=BTCUSDT,ETHUSDT

# 캔들 주기: 1m, 5m, 15m, 1h, 4h, 1d
INTERVAL=15m

# 폴링 주기 (초)
POLL_SECONDS=60

# 전략 파라미터
EMA_FAST=9
EMA_SLOW=21
RSI_PERIOD=14
RSI_LONG_MAX=70
RSI_SHORT_MIN=30
ATR_PERIOD=14
ATR_SL_MULT=1.5
ATR_TP_MULT=3.0

# 같은 심볼 재알림 최소 간격 (초)
COOLDOWN_SECONDS=3600

# Binance 선물 API 베이스 URL (지역 차단 시 미러/테스트넷으로 교체)
# BINANCE_FAPI_BASE=https://testnet.binancefuture.com

# Telegram 설정 (비워두면 콘솔 로그만 출력)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
