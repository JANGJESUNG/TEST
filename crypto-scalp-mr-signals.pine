//@version=5
// ─────────────────────────────────────────────────────────────────────────────
// 단기 평균회귀 스캘핑 타점 [RSI(2) 극단 + EMA200 게이트 + 시간 청산]
//
// 배경   : 저타임프레임(15m~30m) 요청으로 신규 설계. 추세 눌림목 전략은 1h 아래에서
//          엣지 소멸(RESULTS.md 8차) → 저TF에 맞는 평균회귀 구조로 별도 개발(9차).
// 검증   : 30분봉 BTC/ETH/LTC/XRP/EOS 2년(2017-10~2019-10), 3,056 트레이드 —
//          승률 46.6%, PF 1.18(혼합 수수료 0.0375%)/1.14(테이커 0.055%),
//          5개 심볼 전부 양수, 파라미터 전 영역(시간 12~36봉·SL 1.5~2.5ATR) 안정.
// 경고   : ① "높은 승률(68%)" 구성은 검증상 전부 손실(PF 0.9) — 잦은 소익절은
//             수수료가 갉아먹는다. 채택된 구조의 승률은 ~47%다.
//          ② 진짜 15분봉 검증 표본은 제한적 — 근거는 30분봉. 15분은 실험 단계.
//          ③ 수수료 민감 — 지정가(메이커) 진입 강력 권장.
//
// 규칙 (봉 마감 확정):
//   롱  : 종가 > EMA200  and  RSI(2) < 5   (상승 구조 속 급락 매수)
//   숏  : 종가 < EMA200  and  RSI(2) > 95  (하락 구조 속 급등 매도)
//   손절: 진입가 ± 2.5×ATR (원금 한도 캡 적용)
//   청산: 목표가 없음 — N봉(기본 16봉) 경과 시 종가 청산 ("시간 청산")
//          평균회귀는 익절가로 수익을 자르는 것보다 시간 청산이 우수했음 (9차 검증)
// ─────────────────────────────────────────────────────────────────────────────
indicator("스캘핑 MR 타점 [RSI2+시간청산]", shorttitle="스캘핑 MR", overlay=true, max_labels_count=500, max_lines_count=500)

// ═══════════════ 입력값 ═══════════════
grpSig = "① 신호"
rsiTh   = input.float(5, "RSI(2) 극단 기준 (롱: 미만 / 숏: 100-값 초과)", minval=1, maxval=20, step=1, group=grpSig)
emaLen  = input.int(200, "추세 게이트 EMA", minval=50, group=grpSig)
cooldown = input.int(5, "신호 재발생 최소 간격 (봉)", minval=0, group=grpSig)

grpExit = "② 청산 (시간 청산 구조)"
atrMult = input.float(2.5, "손절 = ATR × 배수", minval=1.0, step=0.5, group=grpExit)
timeStopBars = input.int(16, "시간 청산 (진입 후 N봉, 손절 미도달 시 종가 청산)", minval=4, group=grpExit, tooltip="검증상 12~36봉 전 구간 유효, 16봉=승률 균형 / 24봉=기대값 최대")

grpRisk = "③ 리스크 (빈도가 높아 저리스크 필수!)"
capital = input.float(1000, "운용 원금 (USDT)", minval=1, group=grpRisk)
posPct  = input.float(50, "포지션 비중 (원금의 %)", minval=5, maxval=200, step=5, group=grpRisk, tooltip="주 5~6회 거래되는 전략이므로 트레이드당 실질 리스크 ~1%(비중 50% × 손절폭 2%)를 권장. 검증 MDD -15~-30%")
maxLossPct = input.float(1.25, "원금 대비 최대 손실 한도 (%)", minval=0.25, step=0.25, group=grpRisk)

// ═══════════════ 계산 ═══════════════
ema200 = ta.ema(close, emaLen)
rsi2 = ta.rsi(close, 2)
atr = ta.atr(14)

var int lastSignalBar = -99999
canSignal = bar_index - lastSignalBar > cooldown

longSignal  = close > ema200 and rsi2 < rsiTh and canSignal and barstate.isconfirmed
shortSignal = close < ema200 and rsi2 > 100 - rsiTh and not longSignal and canSignal and barstate.isconfirmed
if longSignal or shortSignal
    lastSignalBar := bar_index

// 손절: ATR 배수, 단 원금 한도 캡 (손실이 한도 초과 불가)
lev = posPct / 100.0
capStopFrac = maxLossPct / math.max(lev, 0.01) / 100.0

f_draw(bool isLong) =>
    entry = close
    slAtr = isLong ? entry - atrMult * atr : entry + atrMult * atr
    slCap = isLong ? entry * (1 - capStopFrac) : entry * (1 + capStopFrac)
    sl = isLong ? math.max(slAtr, slCap) : math.min(slAtr, slCap)
    lossPct = math.abs(entry - sl) / entry * lev * 100
    qty = capital * lev / entry
    exitMs = time + timeStopBars * timeframe.in_seconds() * 1000
    txt = "◆ " + (isLong ? "롱 스캘핑 (급락 평균회귀)" : "숏 스캘핑 (급등 평균회귀)") + " ◆\n"
      + "진입가: " + str.tostring(entry, format.mintick) + "\n"
      + "손절가: " + str.tostring(sl, format.mintick) + "  (원금 " + str.tostring(-lossPct, "#.##") + "%)\n"
      + "청산 규칙: 목표가 없음 — " + str.tostring(timeStopBars) + "봉 후 종가 청산\n"
      + "청산 예정: " + str.format_time(exitMs, "MM-dd HH:mm", syminfo.timezone) + "\n"
      + "권장 수량: " + str.tostring(qty, "#.####") + " (원금의 " + str.tostring(posPct, "#") + "%)\n"
      + "─── 근거 ───\n"
      + (isLong ? "· EMA200 위 (상승 구조 유지)\n· RSI(2)=" + str.tostring(rsi2, "#.#") + " 단기 투매 극단\n" :
                  "· EMA200 아래 (하락 구조 유지)\n· RSI(2)=" + str.tostring(rsi2, "#.#") + " 단기 과열 극단\n")
      + "· 지정가 진입 권장 (수수료 절감)\n"
    label.new(bar_index, isLong ? low : high, txt,
      style=isLong ? label.style_label_up : label.style_label_down,
      color=isLong ? color.new(color.teal, 10) : color.new(color.maroon, 10),
      textcolor=color.white, size=size.small, textalign=text.align_left)
    line.new(bar_index, sl, bar_index + timeStopBars, sl, color=color.red, width=2, style=line.style_dashed)
    line.new(bar_index, entry, bar_index + timeStopBars, entry, color=color.gray, width=1)
    // 시간 청산 시점 수직 표시
    line.new(bar_index + timeStopBars, sl, bar_index + timeStopBars, entry, color=color.orange, width=2)
    label.new(bar_index + timeStopBars, entry, "⏱ 시간청산", style=label.style_label_left, color=color.new(color.orange, 60), textcolor=color.white, size=size.tiny)

if longSignal
    f_draw(true)
if shortSignal
    f_draw(false)

// ═══════════════ 차트 표시 ═══════════════
plot(ema200, "EMA 200", color=color.new(color.purple, 0), linewidth=2)
plotshape(longSignal,  "롱 신호", shape.triangleup,   location.belowbar, color.new(color.teal, 0),   size=size.small)
plotshape(shortSignal, "숏 신호", shape.triangledown, location.abovebar, color.new(color.maroon, 0), size=size.small)

var table t = table.new(position.top_right, 2, 4, bgcolor=color.new(color.black, 20), border_width=1, border_color=color.new(color.gray, 60))
if barstate.islast
    gateTxt = close > ema200 ? "상승 구조 (롱만 대기)" : "하락 구조 (숏만 대기)"
    rsiTxt = str.tostring(rsi2, "#.#") + (rsi2 < rsiTh ? " ⚡급락 극단" : rsi2 > 100 - rsiTh ? " ⚡급등 극단" : " 중립")
    table.cell(t, 0, 0, "구조(EMA200)", text_color=color.white, text_size=size.tiny), table.cell(t, 1, 0, gateTxt, text_color=close > ema200 ? color.green : color.red, text_size=size.tiny)
    table.cell(t, 0, 1, "RSI(2)",      text_color=color.white, text_size=size.tiny), table.cell(t, 1, 1, rsiTxt, text_color=color.silver, text_size=size.tiny)
    table.cell(t, 0, 2, "실질 리스크",  text_color=color.white, text_size=size.tiny), table.cell(t, 1, 2, "~" + str.tostring(atrMult * atr / close * lev * 100, "#.##") + "%/회", text_color=color.orange, text_size=size.tiny)
    table.cell(t, 0, 3, "권장 TF",     text_color=color.white, text_size=size.tiny), table.cell(t, 1, 3, "30m (15m은 실험)", text_color=color.silver, text_size=size.tiny)

alertcondition(longSignal,  "롱 스캘핑 신호", "스캘핑 MR: 롱 진입 후보 — 라벨의 손절가/시간청산 확인, 지정가 진입 권장")
alertcondition(shortSignal, "숏 스캘핑 신호", "스캘핑 MR: 숏 진입 후보 — 라벨의 손절가/시간청산 확인, 지정가 진입 권장")
